{
  "name": "faro-react-wrapper",
  "version": "0.2.0",
  "description": "Grafana faro react wrapper",
  "type": "module",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "unpkg": "dist/index.umd.min.js",
  "jsdelivr": "dist/index.umd.min.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "dev": "tsup src/index.ts --format esm,cjs --watch --dts",
    "build": "npm run clean && rollup -c",
    "build:all": "npm run clean && rollup -c --environment BUILD:production",
    "build:dev": "npm run clean && rollup -c --environment BUILD:development",
    "build:min": "npm run clean && rollup -c --environment MINIFY:true",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watchAll",
    "prepare": "npm run build:all"
  },
  "keywords": [
    "typescript",
    "library"
  ],
  "author": "vlprojects",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/jest": "^30.0.0",
    "jest": "^30.2.0",
    "rollup": "^4.55.2",
    "rollup-plugin-dts": "^6.3.0",
    "ts-jest": "^29.4.5",
    "tslib": "^2.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "@grafana/faro-react": "^1.19.0",
    "@grafana/faro-transport-otlp-http": "^1.19.0",
    "history": "^5.3.0"
  }
}
